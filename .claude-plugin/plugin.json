{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "bordfeed",
  "version": "0.1.0",
  "description": "Search active job listings and pull full jobs from Bordfeed saved feeds through the hosted Bordfeed MCP server.",
  "author": {
    "name": "Bordfeed",
    "email": "support@bordfeed.com",
    "url": "https://bordfeed.com"
  },
  "homepage": "https://bordfeed.com/docs/mcp",
  "repository": "https://github.com/craftled/bordfeed-plugin",
  "license": "MIT",
  "keywords": [
    "bordfeed",
    "jobs",
    "job-board",
    "job-data",
    "careers",
    "mcp",
    "api"
  ],
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "Bordfeed API key",
      "description": "A bf_live_ key from https://bordfeed.com/dashboard/organization/api-keys. Saved in secure storage, not in settings.json.",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "bordfeed": {
      "type": "http",
      "url": "https://bordfeed.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.api_key}"
      }
    }
  }
}
